<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kk.mapper.EmpMapper">
    <!--批量删除员工基本信息-->
    <delete id="deleteByIds">
        delete from emp where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>

    <!--&lt;!&ndash;根据员工信息批量删除员工经历&ndash;&gt;
    <delete id="deleteByEmpIds">
        delete from emp_expr where emp_id in
        <foreach collection="empIds" item="empId" separator="," open="(" close=")">
            #{empId}
        </foreach>
    </delete>-->

    <select id="list" resultType="com.kk.pojo.Emp">
        select e.*,d.name as deptName from emp e left join dept d on e.dept_id=d.id
        <where>
            <if test="name != null and name != ''">
                and e.name like concat('%', #{name}, '%')
            </if>
            <if test="gender != null and gender != 0">
                and e.gender = #{gender}
            </if>
            <if test="begin != null and end != null">
                and e.entry_date between #{begin} and #{end}
            </if>
        </where>
        order by e.update_time desc
    </select>

    <!--根据ID查询员工基本信息及员工经历-->
    <select id="getById" resultType="com.kk.pojo.Emp">
        select
            e.*,
            e2.id ee_id,
            e2.emp_id ee_empid,
            e2.`begin` ee_begin,
            e2.`end` ee_end,
            e2.company ee_company,
            e2.job ee_job
        from emp e left join emp_expr e2 on e.id=e2.emp_id where e.id=#{id};
    </select>

    <insert id="insertBatch" parameterType="com.kk.pojo.EmpExpr">
        insert into emp_expr(emp_id,bigin,end,company,job)
        values
        <foreach collection="exprList" item="expr" separator=",">
            (#{expr.empId},#{expr.bigin},#{expr.end},#{expr.company},#{expr.job})
        </foreach>
    </insert>
</mapper>